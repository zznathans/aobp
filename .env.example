# Copy to .env and fill in as needed.

# EVE Online SSO (https://developers.eveonline.com/applications)
EVE_SSO_CLIENT_ID=
EVE_SSO_CALLBACK_URL=http://localhost:8000/auth/callback
EVE_SSO_SCOPES=esi-characters.read_blueprints.v1 esi-assets.read_assets.v1 esi-industry.read_character_jobs.v1 esi-universe.read_structures.v1

# EVE ESI (https://esi.evetech.net) - set ESI_USER_AGENT to identify your app per ESI's guidelines
ESI_USER_AGENT=aobp

# MongoDB
MONGODB_URI=mongodb://aobp:changeme@localhost:27017/aobp?authSource=admin
MONGODB_DATABASE=aobp

# Redis (optional cache for SDE lookups and location names; app falls back to
# MongoDB directly if disabled)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Session cookie signing
SESSION_SECRET_KEY=
