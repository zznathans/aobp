# Copy to .env and fill in as needed.

# EVE Online SSO (https://developers.eveonline.com/applications)
EVE_SSO_CLIENT_ID=
EVE_SSO_CALLBACK_URL=http://localhost:8000/auth/callback
EVE_SSO_SCOPES=esi-characters.read_blueprints.v1 esi-assets.read_assets.v1 esi-industry.read_character_jobs.v1 esi-universe.read_structures.v1

# Optional, separate grant requested only when a character clicks "Connect
# corporation data" in /settings - not part of the base login scopes above, so
# most users never see a corp-permission prompt. Corp assets/blueprints require
# the character to hold the Director role in their corp; corp industry jobs
# allows Director or Factory_Manager. Must also be enabled on the app
# registration at developers.eveonline.com, same as EVE_SSO_SCOPES.
EVE_SSO_CORP_SCOPES=esi-assets.read_corporation_assets.v1 esi-corporations.read_blueprints.v1 esi-industry.read_corporation_jobs.v1

# EVE ESI (https://esi.evetech.net) - set ESI_USER_AGENT to identify your app per ESI's guidelines
ESI_USER_AGENT=eve-build

# MongoDB
MONGODB_URI=mongodb://eve-build:changeme@localhost:27017/eve-build?authSource=admin
MONGODB_DATABASE=eve-build

# Redis (optional cache for SDE lookups and location names; app falls back to
# MongoDB directly if disabled)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Session cookie signing
SESSION_SECRET_KEY=
